# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# Caches / intermediate compute
_cache/
.worst_sperm_cache.json
*.log

# Raw microscopy data is large and is NOT committed. The raw videos / image
# volumes and the oversized segmentation masks are replaced by *.PLACEHOLDER text
# files and can be requested from the authors (see source_data/README.md).
# Ignore the large raw formats everywhere...
*.npy
*.npz
*.nrrd
*.tif
*.tiff
*.mat
*.h5
*.hdf5

# ...but keep the committed lightweight inputs (each component's data/ folder),
# the small segmentation masks that fit under source_data/, and the source_data
# documentation. The *.PLACEHOLDER stand-ins are plain text and tracked normally.
!*/data/**
!source_data/**/*.nrrd
!source_data/README.md

# OS
.DS_Store
Thumbs.db
